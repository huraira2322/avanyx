rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hurairahussain667@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }


    function isAuthorizedForBusiness(businessId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        businessId == 'biz-' + request.auth.uid ||
        (resource != null && (
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
        )) ||
        (exists(/databases/$(database)/documents/businesses/$(businessId)) && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid ||
          (get(/databases/$(database)/documents/businesses/$(businessId)).data.memberUids != null &&
           request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.memberUids)
        ))
      );
    }

    // Default catch-all allows super admin
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // System configurations & Super Admin logs
    match /system/{document=**} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /referral_partners/{partnerId} {
      allow read, write: if true;
    }

    // Referral & Promoter Network Rules
    match /referral_promoters/{promoterId} {
      allow read, write: if true;
    }

    match /referral_codes/{codeId} {
      allow read, write: if true;
    }

    match /referral_leads/{leadId} {
      allow read, write: if true;
    }

    match /referral_conversions/{convId} {
      allow read, write: if true;
    }

    match /referral_payouts/{payoutId} {
      allow read, write: if true;
    }

    match /referral_config/{configId} {
      allow read, write: if true;
    }

    match /system_activity/{activityId} {
      allow read, write: if true;
    }

    // User profiles & business mapping
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // Business Root Document & Subcollections
    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        businessId == 'biz-' + request.auth.uid ||
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow create: if isSignedIn() && 
                    businessId == 'biz-' + request.auth.uid && 
                    request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        businessId == 'biz-' + request.auth.uid ||
        (resource != null && resource.data.ownerUid == request.auth.uid)
      );

      // Workstations Security Rule
      match /workstations/{deviceId} {
        allow read, write: if isAuthorizedForBusiness(businessId);
      }

      // Scannable digital receipts & POS sales
      match /sales/{saleId} {
        allow read, write: if isAuthorizedForBusiness(businessId);
      }

      // All subcollections (products, sales, customers, expenses, subusers, suppliers, purchaseOrders, saleOrders, estimates, creditNotes, deliveryNotes, budgets, roles, otherIncomes)
      match /{allSubcollections=**} {
        allow read, write: if isAuthorizedForBusiness(businessId);
      }
    }

    // Default deny all other unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
